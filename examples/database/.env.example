# Copy to .env (kept out of git) and change the passwords. SQL Server needs 8+ characters with
# upper and lower case letters, digits and symbols.
POSTGRES_ADMIN_USER=acme_admin
POSTGRES_ADMIN_PASSWORD=change-me-Postgres1!
MYSQL_ROOT_PASSWORD=change-me-MySQL1!
MSSQL_SA_PASSWORD=change-me-MSSQL1!
# The read-only user doctracker connects with (doctracker_reader), the same on every server.
READER_PASSWORD=change-me-Reader1!
POSTGRES_PORT=55432
MYSQL_PORT=53306
MSSQL_PORT=51433
