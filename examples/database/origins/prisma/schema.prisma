// The acme core schema as a Prisma schema: the state after the five migration steps.
// The database comes from the ACME_DATABASE_URL environment variable.

datasource db {
  provider = "postgresql"
  url      = env("ACME_DATABASE_URL")
}

/// Categories of products, as a tree.
model Category {
  id       Int        @id @default(autoincrement())
  parentId Int?       @map("parent_id")
  name     String
  slug     String     @unique
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

/// What the shop sells.
model Product {
  id         Int         @id @default(autoincrement())
  sku        String      @unique
  name       String
  categoryId Int         @map("category_id")
  price      Decimal     @db.Decimal(12, 2)
  active     Boolean     @default(true)
  cost       Decimal?    @db.Decimal(12, 2)
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@map("products")
}

/// People who buy at the shop.
model Customer {
  id        BigInt   @id @default(autoincrement())
  fullName  String   @map("full_name")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  cpf       String?  @unique @db.Char(14)
  phone     String?
  orders    Order[]

  @@map("customers")
}

/// An order of a customer.
model Order {
  id         BigInt      @id @default(autoincrement())
  customerId BigInt      @map("customer_id")
  status     String      @default("draft")
  placedAt   DateTime?   @map("placed_at") @db.Timestamptz
  total      Decimal     @default(0) @db.Decimal(12, 2)
  customer   Customer    @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  payments   Payment[]

  @@index([customerId], map: "orders_customer")
  @@map("orders")
}

/// The lines of an order.
model OrderItem {
  orderId   BigInt  @map("order_id")
  line      Int     @db.SmallInt
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@id([orderId, line])
  @@map("order_items")
}

/// Money received for an order.
model Payment {
  id      BigInt   @id @default(autoincrement())
  orderId BigInt   @map("order_id")
  paidAt  DateTime @map("paid_at") @db.Timestamptz
  amount  Decimal  @db.Decimal(12, 2)
  method  String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}
